# ---- Capital One Nessie ----
# mock = offline fake bank (works with no key), live = real Nessie API
NESSIE_MODE=mock
NESSIE_KEY=
NESSIE_BASE=http://api.nessieisreal.com

# ---- Photon 2.0 ----
# sim = messages show in the web phone simulator (/web/phones.html)
# live = also send through Photon (implement backend/photon_adapter.py per Photon's guidelines)
PHOTON_MODE=sim
PHOTON_API_KEY=

# ---- AI model (optional) ----
# Leave empty to use the rule-based Coaching Detector.
# Examples: anthropic:claude-sonnet-4-5 | openai:gpt-4o-mini | bedrock_converse:<model-id>
MODEL=

# pipeline = deterministic orchestration (safest for demos)
# deepagents = LangChain deepagents planner decides the next step (needs MODEL)
AGENT_MODE=pipeline

# ---- LangSmith tracing (to show judges the agent trace) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scam-interrupt

# ---- Demo phone numbers (teammates' phones, with their consent) ----
MARY_PHONE=+15550000001
DAVID_PHONE=+15550000002

DB_PATH=data/scam_interrupt.db
